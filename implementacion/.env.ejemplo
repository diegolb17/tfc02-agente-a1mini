# Copia este archivo como .env y completa los valores. .env no se sube al repositorio.
TELEGRAM_TOKEN=
# Lo escribe solo el modo --registrar-operador con el primer /start privado.
TELEGRAM_OPERADOR_ID=
# Impresora en modo LAN y modo desarrollador (pantalla de la A1 mini, ajustes de red).
IMPRESORA_IP=
IMPRESORA_SERIE=
IMPRESORA_CODIGO_ACCESO=
# La clave de OpenAI de este archivo prevalece sobre la del entorno del sistema.
OPENAI_API_KEY=
MODELO=gpt-5.4-mini
# Al maximo hasta fijarlo con el conjunto de prueba (tesis, R-SEG-01).
UMBRAL_CONFIANZA=1.0
UMBRAL_FALLA=0.5
PERIODO_SUPERVISION_S=600
PLAZO_CONFIRMACION_S=1800
RECORDATORIO_PAUSA_S=900
# Panel de Cloudflare (carpeta panel/). PANEL_CLAVE es el secreto EQUIPO_CLAVE del worker.
PANEL_URL=
PANEL_CLAVE=
# Credenciales del administrador de la pagina; en el worker solo va su resumen PBKDF2.
PANEL_USUARIO=
PANEL_CONTRASENA=
